FROM carla-merc:latest

# ── Runtime dependencies only ─────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvulkan1 \
    vulkan-tools \
    libxcursor1 \
    libxrandr2 \
    libxinerama1 \
    libxi6 \
    && rm -rf /var/lib/apt/lists/*

# ── NVIDIA / Vulkan env ───────────────────────────────────────────────────────
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV __GLX_VENDOR_LIBRARY_NAME=nvidia
ENV __NV_PRIME_RENDER_OFFLOAD=1
ENV SDL_VIDEODRIVER=offscreen

# ── CARLA ports ───────────────────────────────────────────────────────────────
# 2000 — Python API (primary RPC)
# 2001 — Traffic Manager
# 8080 — optional streaming server
EXPOSE 2000 2001 8080

# ── Entrypoint: find the package and launch headless ─────────────────────────
# CarlaSetup.sh may place the package at Build/Package/ or Build/Package/Linux/
COPY docker/carla_entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
